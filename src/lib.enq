fn transport_request(http: HTTPAsyncClient, config: HttpClientConfig, method: str, address: str, body: str, cancellation: Option[HTTPCancellationToken], json_body: bool) -> Result[HTTPResponseFuture, BotError] {
    let url = match Url::parse(address) {
        Result::Ok(url) => url
        Result::Err(_) => {
            ret Result::Err(error(ErrorKind::Configuration, "invalid Bot API request URL"))
        }
    }
    let mut request = HttpRequest::new(method, url).with_body(body)
    if json_body {
        request = request.with_header("Content-Type", "application/json")
    }
    let mut future = http.with_config(config).send(request)
    match cancellation {
        Option::Some(token) => {
            future = future.with_cancellation(token)
        }
        Option::None => {
        }
    }
    ret Result::Ok(future)
}
